# Copy to .env.local for local development, or set the same keys in Vercel → Settings → Environment Variables.

# Public site URL (used for Open Graph). On Vercel it falls back to the production domain automatically.
VITE_SITE_URL=

# Official contacts shown on the site. Leave empty until the company confirms them.
VITE_CONTACT_PHONE=
VITE_CONTACT_TELEGRAM=
VITE_CONTACT_EMAIL=

# Optional: send leads to another endpoint instead of /api/lead. It must answer {"ok": true} with a 2xx status.
VITE_LEAD_ENDPOINT=

# Server-only (never prefix with VITE_): used by api/lead.ts to forward leads to Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
